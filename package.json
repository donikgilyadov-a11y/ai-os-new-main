{
  "name": "gridpost",
  "version": "0.2.2",
  "description": "Gridpost — local-first lightweight desktop client for running a multi-language social grid",
  "main": "./out/main/index.js",
  "author": "Gridpost contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "unit": "node scripts/unit.mjs",
    "test": "npm run typecheck && npm run unit && npm run smoke",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "app.gridpost.desktop",
    "productName": "Gridpost",
    "publish": {
      "provider": "github",
      "owner": "donikgilyadov-a11y",
      "repo": "ai-os-new-main"
    },
    "files": [
      "out/**/*",
      "plugins/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "Gridpost-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    }
  }
}
